{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "file-capability",
	"description": "Hardened file capability: frontend fs plugin is limited to application config data; broad file IO is handled by audited Rust commands.",
	"windows": ["*"],
	"permissions": [
		"fs:default",
		"fs:allow-exists",
		"fs:allow-mkdir",
		"fs:allow-read-text-file",
		"fs:allow-write-text-file",
		"fs:allow-remove",
		{
			"identifier": "fs:scope",
			"allow": [
				{ "path": "$APPCONFIG" },
				{ "path": "$APPCONFIG/**" },
				{ "path": "$APPDATA" },
				{ "path": "$APPDATA/**" },
				{ "path": "$APPLOCALDATA" },
				{ "path": "$APPLOCALDATA/**" }
			]
		},
		{
			"identifier": "opener:allow-open-path",
			"allow": [
				{ "path": "$APPCONFIG" },
				{ "path": "$APPCONFIG/**" },
				{ "path": "$APPDATA" },
				{ "path": "$APPDATA/**" },
				{ "path": "$APPLOCALDATA" },
				{ "path": "$APPLOCALDATA/**" },
				{ "path": "$DESKTOP" },
				{ "path": "$DESKTOP/**" },
				{ "path": "$DOCUMENT" },
				{ "path": "$DOCUMENT/**" },
				{ "path": "$DOWNLOAD" },
				{ "path": "$DOWNLOAD/**" },
				{ "path": "$PICTURE" },
				{ "path": "$PICTURE/**" },
				{ "path": "$VIDEO" },
				{ "path": "$VIDEO/**" }
			]
		}
	]
}
