{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "Snow Shot",
	"mainBinaryName": "snowshot",
	"version": "0.7.10-beta",
	"identifier": "com.chao.snowshot",
	"build": {
		"removeUnusedCommands": true,
		"frontendDist": "../dist",
		"devUrl": "http://localhost:8083",
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"fullscreen": false,
				"height": 632,
				"maximizable": false,
				"title": "Snow Shot",
				"width": 1024,
				"center": true,
				"decorations": false,
				"shadow": false,
				"transparent": true,
				"backgroundColor": "#00000000",
				"visible": false,
				"backgroundThrottling": "disabled",
				"url": "/"
			}
		],
		"macOSPrivateApi": true,
		"security": {
			"csp": null,
			"capabilities": [
				"default",
				"desktop-capability",
				"drag-capability",
				"file-capability"
			],
			"assetProtocol": {
				"enable": true,
				"scope": ["*", "**"]
			}
		}
	}
}
