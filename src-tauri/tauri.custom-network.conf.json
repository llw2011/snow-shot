{
	"build": {
		"beforeDevCommand": {
			"script": "node scripts/build.mjs dev --flavor custom",
			"cwd": ".."
		},
		"beforeBuildCommand": {
			"script": "node scripts/build.mjs frontend --flavor custom",
			"cwd": ".."
		}
	},
	"app": {
		"security": {
			"capabilities": [
				"default",
				"desktop-capability",
				"drag-capability",
				"file-capability",
				"custom-network-capability"
			]
		}
	}
}
